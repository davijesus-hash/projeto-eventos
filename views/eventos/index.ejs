<%- include('../includes/header',{titulo:"Eventos", usuario}) %>
    <main class="conteudo">
        <div class="cabecalho-conteudo">
            <div>
                <h1>Eventos</h1>
                <p>Organize os eventos.</p>
            </div>
            <a class="btn btn-primario" href="/eventos/novo">
                + Novo Evento
            </a>
        </div>
        <section class="lista-eventos">
            <% eventos.forEach(evento=> { %>
                <article class="card card-evento">
                    <img src="/img/upload/<%= evento.imagem_url %>" alt="<%= evento.titulo %>">
                    <div class="conteudo-card-evento">
                        <div>
                            <span class="categoria-evento">
                                <%= evento.categoria %>
                            </span>
                        </div>
                        <h3>
                            <%= evento.titulo %>
                        </h3>
                        <p>
                            <%= evento.descricao %>
                        </p>
                        <div class="informacoes-evento">
                            <span>
                                <strong>Data:</strong>
                                <%= evento.data_evento.toLocaleDateString('pt-BR') %>
                            </span>
                            <span>
                                <strong>Horário:</strong>
                                <%= evento.horario.slice(0, 5) %>
                            </span>
                            <span>
                                <strong>Local:</strong>
                                <%= evento.local %>
                            </span>
                            <span>
                                <strong>Vagas:</strong>
                                <%= evento.quantidade_vagas %>
                            </span>
                            <span>
                                <strong>Responsável:</strong>
                                <%= evento.organizador %>
                            </span>
                        </div>
                        <div class="acoes-evento">
                            <a class="btn btn-sucesso btn-sm" href="/eventos/editar/<%= evento.id %>">
                                Editar
                            </a>
                        </div>
                    </div>
                </article>
                <% }) %>
        </section>
    </main>
    <%- include('../includes/footer') %>
<%-include('../includes/header', 
    {titulo:"Usuários",usuario})
%>
<main class="conteudo">
  <div class="cabecalho-conteudo">
    <div>
      <h1>Usuários</h1>
      <p>Organize os usuários do sistema</p>
    </div>
    <a class="btn btn-primario" href="/usuarios/novo">
      + Novo usuário
    </a>
  </div>
  <div class="tabela-container">
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Nome</th>
          <th>E-mail</th>
          <th>Situação</th>
          <th>Data de cadastro</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% usuarios.forEach(u => { %>
        <tr>
          <td>
            <%= u.id %>
          </td>
          <td>
            <strong> <%= u.nome %> </strong>
          </td>
          <td>
            <%= u.email %>
          </td>
          <td>
            <span class="status <%= u.situacao===1?'status-ativo':'status-inativo' %>">
              <%= u.situacao===1?'Ativo':'Inativo' %>
            </span>
          </td>
          <td>
            <%= u.criado_em.toLocaleDateString('pt-BR') %>
          </td>
          <td class="acoes">
            <form action="/usuarios/excluir/<%= u.id %>" method="POST" onsubmit="return confirm('Deseja realmente excluir esse usuario?')">

              <button type="submit" title="Excluir" class="btn btn-danger btn-sm">
                Deletar
              </button>
            </form>
            <a class="btn btn-sucesso btn-sm" href="/usuarios/editar/<%= u.id %>">
              Editar
            </a>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</main>
<%-include('../includes/footer')%>
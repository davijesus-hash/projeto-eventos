<%- include('../includes/header', { titulo: "Cadastrar Usuário" , usuario }) %>
    <main class="conteudo">
        <div class="cabecalho-conteudo">
            <div>
                <h1>Cadastrar um Participante</h1>
                <p>Crie um novo participante para organizar os eventos.</p>
            </div>
        </div>
        <div class="card">
            <form action="/participantes/novo" method="POST">
                <div class="linha-formulario">
                    <div class="campo-formulario">
                        <label for="nome">Nome Completo</label>
                        <input type="text" id="nome" name="nome" placeholder="Digite o nome do participante" required
                            maxlength="100" minlength="2">
                    </div>
                </div>
                <div class="linha-formulario" style="margin-top: 16px;">
                    <div class="campo-formulario">
                        <label for="email">Email</label>
                        <input 
                            type="email" 
                            id="email" 
                            name="email" 
                            placeholder="Digite o email do participante" required
                            maxlength="100" 
                            minlength="2"
                        >
                    </div>
                    <div class="campo-formulario">
                        <label for="telefone">Telefone</label>
                        <input 
                            type="text" 
                            id="telefone" 
                            name="telefone" 
                            placeholder="Digite o telefone do participante" required
                            maxlength="100" 
                            minlength="2"
                        >
                    </div>
                </div>
                <div class="botoes-formulario">
                    <a class="btn btn-muted" href="/participantes">
                        Cancelar
                    </a>
                    <button class="btn btn-primario" type="submit">
                        Salvar
                    </button>
                </div>
            </form>
        </div>
    </main>
    <%- include('../includes/footer') %>